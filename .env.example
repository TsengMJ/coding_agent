# Copy to .env and fill in. .env is gitignored.
# Shell environment variables take precedence over values here.

# Default model for dcode (the -model flag overrides it).
# Format is provider:model; only the first ":" separates the provider.
DCODE_MODEL=openrouter:openai/gpt-6-luna

# OpenRouter (openrouter:* models).
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Attribution headers; set to empty to omit.
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=

# OpenAI (openai:* models).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Postgres checkpointer (thread state, pending interrupts, crash recovery).
# Pass this URL to runtime.NewPostgresCheckpointer. Leave unset to keep
# checkpoints in memory.
# POSTGRES_CONN_STRING=postgres://user:password@localhost:5432/dbname?sslmode=disable
