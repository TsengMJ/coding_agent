# Copy to .env and fill in. .env is gitignored.
# Shell environment variables take precedence over values here.

# Required for openai:* models.
OPENAI_API_KEY=

# Optional: an OpenAI-compatible endpoint (OpenRouter, Ollama, ...).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: default model for dcode (the -model flag overrides it).
# DCODE_MODEL=openai:gpt-5.5
