# Copy to .env and fill in. .env is gitignored.
# Shell environment variables take precedence over values here.

# Default model for dcode (the -model flag overrides it).
# Format is provider:model; only the first ":" separates the provider.
DCODE_MODEL=openrouter:openai/gpt-6-luna-pro

# OpenRouter (openrouter:* models).
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Attribution headers; set to empty to omit.
# OPENROUTER_APP_URL=
# OPENROUTER_APP_TITLE=

# OpenAI (openai:* models).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Brave Search API key; enables dcode's web_search tool (fetch_url works without it).
# BRAVE_API_KEY=

# Context7 API key; enables the resolve_library_id and query_docs tools for
# up-to-date library documentation.
# CONTEXT7_API_KEY=

# Required. dcode stores threads, checkpoints, plans, traces and summarized
# conversation history in Postgres, and refuses to start without it. Put this
# in ~/.deepagents/.env to use the same database from every project directory.
DCODE_POSTGRES_CONN_STRING=postgres://dcode:password@127.0.0.1:5433/dcode?sslmode=disable
# dcode also accepts POSTGRES_CONN_STRING when its dedicated variable is unset.
# dbench uses POSTGRES_CONN_STRING for its separate benchmark database.

# Required. dcode caches web pages, search / extraction / Context7 results and
# large tool outputs in Redis (with expiry), and refuses to start without it.
DCODE_REDIS_URL=redis://127.0.0.1:6379/0
# dcode also accepts REDIS_URL when its dedicated variable is unset.
