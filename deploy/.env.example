# Copy to deploy/.env and fill in. Used by deploy/compose.yaml.

# Public host name; Caddy gets a TLS certificate for it.
QUILL_DOMAIN=quill.example.com

# Host directory for repository clones. It is mounted at the same path in
# the quill container (see compose.yaml) and must exist.
QUILL_WORKSPACES_ROOT=/srv/quill/workspaces

POSTGRES_PASSWORD=

# GitHub OAuth app with device flow enabled (Settings > Developer settings >
# OAuth Apps > Enable Device Flow). Users sign in with it and quill pushes
# branches and opens pull requests with their token.
QUILL_GITHUB_CLIENT_ID=
# Comma-separated GitHub logins allowed to sign in.
QUILL_ALLOWED_USERS=
# 32 random bytes that encrypt stored GitHub tokens: openssl rand -base64 32
# Changing it signs everyone out.
QUILL_SECRET_KEY=

# Model spend per user per UTC day before new runs are refused (0 = no limit).
QUILL_DAILY_LIMIT_USD=20
# Agent features to turn off (quill -disable); unset keeps the shipped
# repair loop, empty turns every feature on.
# QUILL_DISABLE=failure_class,repair_state,repro,planner,stuck,reviewer
# Browser origins of the desktop app allowed to call the API.
# QUILL_ALLOWED_ORIGINS=

# Default model and provider keys (see the repository .env.example).
QUILL_MODEL=openrouter:openai/gpt-6-luna-pro
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# BRAVE_API_KEY=
# CONTEXT7_API_KEY=
