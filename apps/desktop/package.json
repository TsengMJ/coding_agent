{
  "name": "quill-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.json && vite build && tsc -p tsconfig.main.json",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dev:renderer": "vite",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.16",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
